{
  "name": "destiny-bistro-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "data:reset:operational": "tsx scripts/reset-operational-data.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/unit/app.test.ts test/unit/delivery.test.ts test/unit/password.test.ts test/unit/product-catalog.test.ts test/unit/statement-report.test.ts",
    "test:integration": "node --import tsx --test test/integration/ready.integration.test.ts",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "establishment:provision": "tsx scripts/provision-establishment.ts",
    "user:provision": "tsx scripts/provision-user.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.8.1",
    "prisma": "^7.9.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
