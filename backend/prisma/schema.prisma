generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RestaurantTableStatus {
  FREE
  OPEN
  AWAITING_CHECK
}

enum ComandaStatus {
  OPEN
  CANCELLED
  CLOSED
}

enum ComandaEventType {
  OPENED
  CANCELLED
  CLOSED
  ITEM_ADDED
  ITEM_CONFIRMED
  ITEM_QUANTITY_CHANGED
  ITEM_REMOVED
  ITEM_CANCELLED
  ADDITIONALS_CHANGED
}

enum ComandaCancellationReason {
  OPENED_BY_MISTAKE
  OPERATOR_CANCELLED
}

enum CreditOrderSource {
  MANUAL
  TABLE
  DELIVERY
}

enum CreditOrderStatus {
  DRAFT
  OPEN
  SETTLED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
}

enum PaymentOrigin {
  TABLE_CHECKOUT
  CREDIT_INSTALLMENT
  DELIVERY_CHECKOUT
}

enum DeliveryDayStatus {
  OPEN
  CLOSED
}

enum DeliveryOrderStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum IngredientUnit {
  UNIT
  GRAM
  MILLILITER
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  SALE_CONSUMPTION
  ADDITIONAL_CONSUMPTION
  LOSS
  MANUAL_EXIT
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  REVERSAL
}

enum InventoryOperationType {
  ENTRY
  MANUAL
  CONFIRMATION
  CANCELLATION
  CONFIGURATION
}

enum InventoryLotOrigin {
  PURCHASE
  ADJUSTMENT
  REVERSAL
  LEGACY
}

enum InventoryDisposition {
  RETURN_TO_STOCK
  LOSS
}

model Establishment {
  id                 String              @id @default(cuid())
  name               String              @db.VarChar(80)
  normalizedName     String              @unique @db.VarChar(80)
  users              User[]
  restaurantTables   RestaurantTable[]
  comandas           Comanda[]
  creditCustomers    CreditCustomer[]
  creditOrders       CreditOrder[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  products           Product[]
  menuCategories     MenuCategory[]
  comandaItems       ComandaItem[]
  comandaEvents      ComandaEvent[]
  ingredients        Ingredient[]
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  inventoryLots      InventoryLot[]
  inventoryOperations InventoryOperation[]
  inventoryMovementLots InventoryMovementLot[]
  productIngredients ProductIngredient[]
  additionals        Additional[]
  productAdditionals ProductAdditional[]
  additionalIngredients AdditionalIngredient[]
  comandaItemConfigurations ComandaItemConfiguration[]
  comandaItemAdditionals ComandaItemAdditional[]
  comandaItemCancellations ComandaItemCancellation[]
  kitchenTickets     KitchenTicket[]
  kitchenTicketItems KitchenTicketItem[]
  kitchenTicketItemConfigurations KitchenTicketItemConfiguration[]
  kitchenTicketItemAdditionals KitchenTicketItemAdditional[]
  deliveryCouriers   DeliveryCourier[]
  deliveryDays       DeliveryDay[]
  deliveryOrders     DeliveryOrder[]
  deliveries         Delivery[]
  deliveryExpenses   DeliveryExpense[]
  auditLogs          AuditLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model RestaurantTable {
  id              Int                   @id @default(autoincrement())
  establishmentId String
  establishment   Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  number          Int
  status          RestaurantTableStatus @default(FREE)
  activeComandaId String?               @unique
  activeComanda   Comanda?              @relation("ActiveComanda", fields: [activeComandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  comandas        Comanda[]             @relation("TableComandas")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([establishmentId, number])
  @@unique([id, establishmentId])
  @@unique([activeComandaId, establishmentId])
  @@index([establishmentId, status])
}

model Comanda {
  id                 String                     @id @default(cuid())
  establishmentId    String
  establishment      Establishment              @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  number             Int                        @unique @default(autoincrement())
  name               String?                    @db.VarChar(80)
  tableId            Int?
  table              RestaurantTable?           @relation("TableComandas", fields: [tableId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  activeForTable     RestaurantTable?           @relation("ActiveComanda")
  creditOrder        CreditOrder?
  deliveryOrder      DeliveryOrder?
  payments           Payment[]
  status             ComandaStatus              @default(OPEN)
  openedAt           DateTime                   @default(now())
  cancelledAt        DateTime?
  closedAt           DateTime?
  cancellationReason ComandaCancellationReason?
  items              ComandaItem[]
  events             ComandaEvent[]
  kitchenTickets     KitchenTicket[]
  inventoryOperations InventoryOperation[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([id, establishmentId])
  @@index([establishmentId, status])
  @@index([tableId])
  @@index([status, closedAt])
  @@index([status, cancelledAt])
}

model CreditCustomer {
  id              String             @id @default(cuid())
  establishmentId String
  establishment   Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  name            String             @db.VarChar(80)
  normalizedName  String             @db.VarChar(80)
  orders          CreditOrder[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([establishmentId, normalizedName])
  @@unique([id, establishmentId])
  @@index([establishmentId, name])
}

model CreditOrder {
  id              String            @id @default(cuid())
  establishmentId String
  establishment   Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  customerId      String
  customer        CreditCustomer    @relation(fields: [customerId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  comandaId       String            @unique
  comanda         Comanda           @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  source          CreditOrderSource
  status          CreditOrderStatus @default(DRAFT)
  totalCents      Int               @default(0)
  orderedAt       DateTime
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  settledAt       DateTime?
  payments        Payment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([comandaId, establishmentId])
  @@unique([id, establishmentId])
  @@index([establishmentId, status])
  @@index([customerId, status])
  @@index([status, finalizedAt])
}

model Payment {
  id               String              @id @default(cuid())
  establishmentId  String
  establishment    Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaId         String
  comanda           Comanda             @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  creditOrderId     String?
  creditOrder       CreditOrder?        @relation(fields: [creditOrderId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  origin            PaymentOrigin
  amountCents       Int
  recordedByUserId  String?
  recordedByUser    User?               @relation(fields: [recordedByUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  paidAt            DateTime            @default(now())
  allocations       PaymentAllocation[]
  createdAt         DateTime            @default(now())

  @@unique([id, establishmentId])
  @@index([establishmentId, paidAt])
  @@index([comandaId, paidAt])
  @@index([creditOrderId, paidAt])
  @@index([recordedByUserId, paidAt])
  @@index([paidAt])
}

model PaymentAllocation {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  paymentId       String
  payment         Payment       @relation(fields: [paymentId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  method          PaymentMethod
  amountCents     Int
  createdAt       DateTime      @default(now())

  @@unique([paymentId, method])
  @@index([establishmentId, createdAt])
  @@index([paymentId])
}

model MenuCategory {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  name            String        @db.VarChar(80)
  normalizedName  String        @db.VarChar(80)
  active          Boolean       @default(true)
  products        Product[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, normalizedName])
  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
}

model Product {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  code            String
  categoryId      String
  category        MenuCategory  @relation(fields: [categoryId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  name            String
  description     String?       @db.VarChar(255)
  priceCents      Int
  active          Boolean         @default(true)
  requiresKitchen Boolean         @default(false)
  comandaItems    ComandaItem[]
  kitchenTicketItems KitchenTicketItem[]
  ingredients     ProductIngredient[]
  allowedAdditionals ProductAdditional[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([establishmentId, code])
  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
  @@index([categoryId, active, name])
}

model ComandaItem {
  id                String        @id @default(cuid())
  establishmentId   String
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaId         String
  comanda           Comanda       @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  productId         String
  product           Product       @relation(fields: [productId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  productName       String
  unitPriceCents    Int
  quantity          Int
  confirmedQuantity Int           @default(0)
  requiresKitchen   Boolean       @default(false)
  additionalTotalCents Int         @default(0)
  configurations    ComandaItemConfiguration[]
  kitchenTicketItems KitchenTicketItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([comandaId, productId])
  @@unique([id, establishmentId])
  @@index([establishmentId, createdAt])
  @@index([comandaId])
  @@index([productId])
}

model ComandaEvent {
  id               String                     @id @default(cuid())
  establishmentId  String
  establishment    Establishment              @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaId        String
  comanda          Comanda                    @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  type             ComandaEventType
  reason           ComandaCancellationReason?
  itemId           String?
  productId        String?
  productName      String?
  unitPriceCents   Int?
  previousQuantity Int?
  newQuantity      Int?
  actorUserId      String?
  actorUser        User?                      @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  createdAt        DateTime                   @default(now())

  @@index([establishmentId, createdAt])
  @@index([comandaId])
  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
}

model KitchenTicket {
  id              String              @id @default(cuid())
  establishmentId String
  establishment   Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaId       String
  comanda         Comanda             @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  status          KitchenTicketStatus @default(PENDING)
  confirmationKey String              @db.VarChar(191)
  items           KitchenTicketItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([id, establishmentId])
  @@unique([establishmentId, confirmationKey])
  @@index([establishmentId, status, createdAt])
  @@index([comandaId, establishmentId])
}

model KitchenTicketItem {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  kitchenTicketId String
  kitchenTicket   KitchenTicket @relation(fields: [kitchenTicketId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  comandaItemId   String
  comandaItem     ComandaItem   @relation(fields: [comandaItemId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  productId       String
  product         Product       @relation(fields: [productId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  productName     String        @db.VarChar(100)
  quantity        Int
  configurations  KitchenTicketItemConfiguration[]
  createdAt       DateTime      @default(now())

  @@unique([id, establishmentId])
  @@unique([kitchenTicketId, comandaItemId])
  @@index([establishmentId, createdAt])
  @@index([comandaItemId, establishmentId])
  @@index([productId, establishmentId])
}

model KitchenTicketItemConfiguration {
  id                    String                       @id @default(cuid())
  establishmentId       String
  establishment         Establishment                @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  kitchenTicketItemId   String
  kitchenTicketItem     KitchenTicketItem            @relation(fields: [kitchenTicketItemId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  sourceConfigurationId String
  sourceConfiguration   ComandaItemConfiguration     @relation(fields: [sourceConfigurationId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  configurationKey      String                       @db.VarChar(191)
  quantity              Int
  additionals            KitchenTicketItemAdditional[]
  createdAt              DateTime                     @default(now())

  @@unique([id, establishmentId])
  @@unique([kitchenTicketItemId, sourceConfigurationId])
  @@index([establishmentId, createdAt])
  @@index([sourceConfigurationId, establishmentId])
}

model KitchenTicketItemAdditional {
  id                               String                          @id @default(cuid())
  establishmentId                  String
  establishment                    Establishment                   @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  kitchenTicketItemConfigurationId String
  kitchenTicketItemConfiguration   KitchenTicketItemConfiguration @relation(fields: [kitchenTicketItemConfigurationId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  additionalId                     String
  additionalName                   String                          @db.VarChar(100)
  quantityPerUnit                  Int                             @default(1)
  createdAt                        DateTime                        @default(now())

  @@unique([kitchenTicketItemConfigurationId, additionalId])
  @@index([establishmentId, createdAt])
}

model User {
  id                 String              @id @default(cuid())
  establishmentId    String
  establishment      Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  name               String              @db.VarChar(80)
  normalizedName     String              @unique @db.VarChar(80)
  passwordHash       String              @db.VarChar(255)
  active             Boolean             @default(true)
  lastLoginAt        DateTime?
  sessions           AuthSession[]
  roles              UserRole[]          @relation("UserRoles")
  rolesAssigned      UserRole[]          @relation("RoleAssignedBy")
  auditLogs          AuditLog[]
  comandaEvents      ComandaEvent[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  inventoryLots      InventoryLot[]
  inventoryOperations InventoryOperation[]
  inventoryCancellations ComandaItemCancellation[]
  deliveryDaysOpened DeliveryDay[]       @relation("DeliveryDayOpenedBy")
  deliveryDaysClosed DeliveryDay[]       @relation("DeliveryDayClosedBy")
  deliveries         Delivery[]
  deliveryExpenses   DeliveryExpense[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
  @@index([active, name])
}

model Role {
  id                String           @id @default(cuid())
  code              String           @unique @db.VarChar(50)
  name              String           @db.VarChar(80)
  description       String?          @db.VarChar(255)
  system            Boolean          @default(false)
  managerAssignable Boolean          @default(false)
  users             UserRole[]
  permissions       RolePermission[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId           String
  roleId           String
  assignedByUserId String?
  user             User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser   User?    @relation("RoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuditLog {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  userId          String
  user            User          @relation(fields: [userId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  action          String        @db.VarChar(80)
  resourceType    String        @db.VarChar(50)
  resourceId      String        @db.VarChar(191)
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([establishmentId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

model Ingredient {
  id              String          @id @default(cuid())
  establishmentId String
  establishment   Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  code            String          @db.VarChar(50)
  name            String          @db.VarChar(100)
  unit            IngredientUnit
  active          Boolean         @default(true)
  stock           InventoryStock?
  productRecipes  ProductIngredient[]
  additionalRecipes AdditionalIngredient[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([establishmentId, code])
  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
}

model InventoryStock {
  id              String              @id @default(cuid())
  establishmentId String
  establishment   Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  ingredientId    String
  ingredient      Ingredient          @relation(fields: [ingredientId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  quantity        Int                 @default(0)
  minimumQuantity Int                 @default(0)
  deficitQuantity Int                 @default(0)
  movements       InventoryMovement[]
  lots            InventoryLot[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([establishmentId, ingredientId])
  @@unique([ingredientId, establishmentId])
  @@unique([id, establishmentId])
  @@index([establishmentId, updatedAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  establishmentId String
  establishment   Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  stockId         String
  stock           InventoryStock        @relation(fields: [stockId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  operationId     String?
  operation       InventoryOperation?   @relation(fields: [operationId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  type            InventoryMovementType
  quantityDelta   Int
  balanceBefore   Int
  balanceAfter    Int
  reason          String                @db.VarChar(255)
  actorUserId     String
  actorUser       User                  @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  lotAllocations  InventoryMovementLot[]
  createdAt       DateTime              @default(now())

  @@index([establishmentId, createdAt])
  @@index([stockId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([operationId])
}

model InventoryOperation {
  id              String                 @id @default(cuid())
  establishmentId String
  establishment   Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  type            InventoryOperationType
  requestId       String                 @db.VarChar(191)
  sourceId        String?                @db.VarChar(191)
  comandaId       String?
  comanda         Comanda?               @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  actorUserId     String
  actorUser       User                   @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  reason          String?                @db.VarChar(255)
  movements       InventoryMovement[]
  createdAt       DateTime               @default(now())

  @@unique([establishmentId, requestId])
  @@unique([id, establishmentId])
  @@index([comandaId, createdAt])
  @@index([sourceId, createdAt])
}

model InventoryLot {
  id                String             @id @default(cuid())
  establishmentId   String
  establishment     Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  stockId           String
  stock             InventoryStock     @relation(fields: [stockId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  origin            InventoryLotOrigin
  code              String?            @db.VarChar(80)
  initialQuantity   Int
  currentQuantity   Int
  totalCostCents    Int?
  receivedAt        DateTime
  expiresAt         DateTime?
  actorUserId       String
  actorUser         User               @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  movementAllocations InventoryMovementLot[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([id, establishmentId])
  @@unique([establishmentId, stockId, code])
  @@index([stockId, expiresAt, receivedAt])
  @@index([establishmentId, expiresAt])
}

model InventoryMovementLot {
  id              String            @id @default(cuid())
  establishmentId String
  establishment   Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  movementId      String
  movement        InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lotId           String
  lot             InventoryLot      @relation(fields: [lotId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  quantityDelta   Int
  createdAt       DateTime          @default(now())

  @@unique([movementId, lotId])
  @@index([lotId, createdAt])
  @@index([establishmentId, createdAt])
}

model ProductIngredient {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  productId       String
  product         Product       @relation(fields: [productId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  quantity        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, productId, ingredientId])
  @@index([ingredientId])
}

model Additional {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  code            String        @db.VarChar(50)
  name            String        @db.VarChar(100)
  priceCents      Int
  active          Boolean       @default(true)
  products        ProductAdditional[]
  ingredients     AdditionalIngredient[]
  orderItems      ComandaItemAdditional[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, code])
  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
}

model ProductAdditional {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  productId       String
  product         Product       @relation(fields: [productId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  additionalId    String
  additional      Additional    @relation(fields: [additionalId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([establishmentId, productId, additionalId])
  @@index([additionalId])
}

model AdditionalIngredient {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  additionalId    String
  additional      Additional    @relation(fields: [additionalId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  quantity        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, additionalId, ingredientId])
  @@index([ingredientId])
}

model ComandaItemConfiguration {
  id                String        @id @default(cuid())
  establishmentId   String
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaItemId     String
  comandaItem       ComandaItem   @relation(fields: [comandaItemId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  configurationKey  String        @db.VarChar(191)
  quantity          Int
  confirmedQuantity Int           @default(0)
  additionals       ComandaItemAdditional[]
  cancellations     ComandaItemCancellation[]
  kitchenTicketConfigurations KitchenTicketItemConfiguration[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([comandaItemId, configurationKey])
  @@unique([id, establishmentId])
  @@index([establishmentId, createdAt])
}

model ComandaItemAdditional {
  id                String                    @id @default(cuid())
  establishmentId   String
  establishment     Establishment             @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  configurationId   String
  configuration     ComandaItemConfiguration  @relation(fields: [configurationId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  additionalId      String
  additional        Additional                @relation(fields: [additionalId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  additionalName    String                    @db.VarChar(100)
  unitPriceCents    Int
  quantityPerUnit   Int                       @default(1)
  createdAt         DateTime                  @default(now())

  @@unique([configurationId, additionalId])
  @@index([establishmentId, createdAt])
}

model ComandaItemCancellation {
  id              String                    @id @default(cuid())
  establishmentId String
  establishment   Establishment             @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  configurationId String
  configuration   ComandaItemConfiguration  @relation(fields: [configurationId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  quantity        Int
  disposition     InventoryDisposition
  reason          String                    @db.VarChar(255)
  actorUserId     String
  actorUser       User                      @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  createdAt       DateTime                  @default(now())

  @@index([configurationId, createdAt])
  @@index([establishmentId, createdAt])
}

model DeliveryCourier {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  name            String        @db.VarChar(80)
  normalizedName  String        @db.VarChar(80)
  active          Boolean       @default(true)
  days            DeliveryDay[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([establishmentId, normalizedName])
  @@unique([id, establishmentId])
  @@index([establishmentId, active, name])
}

model DeliveryDay {
  id                  String            @id @default(cuid())
  establishmentId     String
  establishment       Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  courierId           String
  courier             DeliveryCourier   @relation(fields: [courierId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  status              DeliveryDayStatus @default(OPEN)
  dailyRateCents      Int               @default(0)
  openedAt            DateTime          @default(now())
  closedAt            DateTime?
  settlementPaidCents Int?
  openedByUserId      String
  openedByUser        User              @relation("DeliveryDayOpenedBy", fields: [openedByUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  closedByUserId      String?
  closedByUser        User?             @relation("DeliveryDayClosedBy", fields: [closedByUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  deliveries          Delivery[]
  deliveryOrders      DeliveryOrder[]
  expenses            DeliveryExpense[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([id, establishmentId])
  @@index([establishmentId, status, openedAt])
  @@index([courierId, status])
  @@index([establishmentId, closedAt])
}

model DeliveryOrder {
  id              String              @id @default(cuid())
  establishmentId String
  establishment   Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  comandaId       String              @unique
  comanda         Comanda             @relation(fields: [comandaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  dayId           String?
  day             DeliveryDay?        @relation(fields: [dayId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  customerName    String              @db.VarChar(80)
  phone           String              @db.VarChar(30)
  address         String              @db.VarChar(255)
  feeCents        Int                 @default(0)
  status          DeliveryOrderStatus @default(NEW)
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([id, establishmentId])
  @@unique([comandaId, establishmentId])
  @@index([establishmentId, status, updatedAt])
  @@index([dayId, status])
}

model Delivery {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  dayId           String
  day             DeliveryDay   @relation(fields: [dayId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  customerName    String        @db.VarChar(80)
  address         String        @db.VarChar(255)
  products        String?       @db.VarChar(255)
  totalCents      Int
  feeCents        Int
  paymentMethod   PaymentMethod
  deliveredAt     DateTime      @default(now())
  actorUserId     String
  actorUser       User          @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([id, establishmentId])
  @@index([establishmentId, deliveredAt])
  @@index([dayId, deliveredAt])
  @@index([actorUserId, deliveredAt])
}

model DeliveryExpense {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  dayId           String
  day             DeliveryDay   @relation(fields: [dayId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  description     String        @db.VarChar(255)
  amountCents     Int
  actorUserId     String
  actorUser       User          @relation(fields: [actorUserId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([id, establishmentId])
  @@index([establishmentId, createdAt])
  @@index([dayId, createdAt])
}
