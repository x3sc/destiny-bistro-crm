generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RestaurantTableStatus {
  FREE
  OPEN
  AWAITING_CHECK
}

enum ComandaStatus {
  OPEN
  CANCELLED
  CLOSED
}

enum ComandaEventType {
  OPENED
  CANCELLED
  CLOSED
  ITEM_ADDED
  ITEM_CONFIRMED
  ITEM_QUANTITY_CHANGED
  ITEM_REMOVED
}

enum ComandaCancellationReason {
  OPENED_BY_MISTAKE
}

enum ProductCategory {
  CLASSIC_BURGERS
  ARTISAN_BURGERS
  EXTRAS
  BEVERAGES
  COCKTAILS
  BEERS
  SIDES
  SNACKS
  COMBOS
  OTHER
}

enum CreditOrderSource {
  MANUAL
  TABLE
}

enum CreditOrderStatus {
  DRAFT
  OPEN
  SETTLED
  CANCELLED
}

model RestaurantTable {
  id              Int                   @id @default(autoincrement())
  number          Int                   @unique
  status          RestaurantTableStatus @default(FREE)
  activeComandaId String?               @unique
  activeComanda   Comanda?              @relation("ActiveComanda", fields: [activeComandaId], references: [id], onDelete: SetNull)
  comandas        Comanda[]             @relation("TableComandas")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Comanda {
  id                 String                     @id @default(cuid())
  number             Int                        @unique @default(autoincrement())
  name               String?                    @db.VarChar(80)
  tableId            Int?
  table              RestaurantTable?           @relation("TableComandas", fields: [tableId], references: [id], onDelete: Restrict)
  activeForTable     RestaurantTable?           @relation("ActiveComanda")
  creditOrder        CreditOrder?
  status             ComandaStatus              @default(OPEN)
  openedAt           DateTime                   @default(now())
  cancelledAt        DateTime?
  closedAt           DateTime?
  cancellationReason ComandaCancellationReason?
  items              ComandaItem[]
  events             ComandaEvent[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([tableId])
}

model CreditCustomer {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(80)
  normalizedName String             @unique @db.VarChar(80)
  orders         CreditOrder[]
  settlements    CreditSettlement[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model CreditOrder {
  id           String             @id @default(cuid())
  customerId   String
  customer     CreditCustomer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  comandaId    String             @unique
  comanda      Comanda            @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  source       CreditOrderSource
  status       CreditOrderStatus  @default(DRAFT)
  totalCents   Int                @default(0)
  orderedAt    DateTime
  finalizedAt  DateTime?
  cancelledAt  DateTime?
  settledAt    DateTime?
  settlementId String?
  settlement   CreditSettlement?  @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([customerId, status])
  @@index([settlementId])
}

model CreditSettlement {
  id          String         @id @default(cuid())
  customerId  String
  customer    CreditCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amountCents Int
  paidAt      DateTime       @default(now())
  orders      CreditOrder[]
  createdAt   DateTime       @default(now())

  @@index([customerId, paidAt])
}

model Product {
  id           String          @id @default(cuid())
  code         String          @unique
  category     ProductCategory @default(OTHER)
  name         String
  priceCents   Int
  active       Boolean         @default(true)
  comandaItems ComandaItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ComandaItem {
  id                String   @id @default(cuid())
  comandaId         String
  comanda           Comanda  @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName       String
  unitPriceCents    Int
  quantity          Int
  confirmedQuantity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([comandaId, productId])
  @@index([comandaId])
  @@index([productId])
}

model ComandaEvent {
  id               String                     @id @default(cuid())
  comandaId        String
  comanda          Comanda                    @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  type             ComandaEventType
  reason           ComandaCancellationReason?
  itemId           String?
  productId        String?
  productName      String?
  unitPriceCents   Int?
  previousQuantity Int?
  newQuantity      Int?
  createdAt        DateTime                   @default(now())

  @@index([comandaId])
}
